diff --git a/syscript.sh b/syscript.sh
new file mode 100755
index 0000000000..12ada22a41
--- /dev/null
+++ b/syscript.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+base=$(git log --diff-filter=A --format=%H -- tsc/internal/checker/ssc.go | tail -n 1)^
+git diff "$base" -- . ':(exclude)syscript.patch' > syscript.patch
+
+node_include_dir=$(node -p "require('path').join(process.execPath, '..', '..', 'include', 'node')")
+
+cd tsc
+go build -o ../built/local/tsc ./cmd/tsc
+CGO_CFLAGS="-I$node_include_dir" go build -buildmode=c-shared -o ../built/local/tsc.node ./cmd/sscapi
+rm -f ../built/local/tsc.h
diff --git a/tsc/cmd/sscapi/addon.c b/tsc/cmd/sscapi/addon.c
new file mode 100644
index 0000000000..4bdd0cf362
--- /dev/null
+++ b/tsc/cmd/sscapi/addon.c
@@ -0,0 +1,48 @@
+#include <stdlib.h>
+#include <node_api.h>
+#include "_cgo_export.h"
+
+static napi_value open(napi_env env, napi_callback_info info) {
+	size_t argc = 1;
+	napi_value argv[1];
+	napi_get_cb_info(env, info, &argc, argv, NULL, NULL);
+	char cwd[4096];
+	size_t cwdLength;
+	napi_get_value_string_utf8(env, argv[0], cwd, sizeof cwd, &cwdLength);
+	sscApiOpen(cwd, (int)cwdLength);
+	return NULL;
+}
+
+static napi_value request(napi_env env, napi_callback_info info) {
+	size_t argc = 2;
+	napi_value argv[2];
+	napi_get_cb_info(env, info, &argc, argv, NULL, NULL);
+	char method[256];
+	size_t methodLength;
+	napi_get_value_string_utf8(env, argv[0], method, sizeof method, &methodLength);
+	void *params;
+	size_t paramsLength;
+	napi_get_buffer_info(env, argv[1], &params, &paramsLength);
+	int resultLength = 0;
+	int isError = 0;
+	char *result = sscApiRequest(method, (int)methodLength, params, (int)paramsLength, &resultLength, &isError);
+	napi_value value = NULL;
+	if (isError) {
+		result = realloc(result, resultLength + 1);
+		result[resultLength] = 0;
+		napi_throw_error(env, NULL, result);
+	} else {
+		napi_create_buffer_copy(env, resultLength, result, NULL, &value);
+	}
+	free(result);
+	return value;
+}
+
+NAPI_MODULE_INIT() {
+	napi_value function;
+	napi_create_function(env, "open", NAPI_AUTO_LENGTH, open, NULL, &function);
+	napi_set_named_property(env, exports, "open", function);
+	napi_create_function(env, "request", NAPI_AUTO_LENGTH, request, NULL, &function);
+	napi_set_named_property(env, exports, "request", function);
+	return exports;
+}
